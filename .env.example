# Copy to .env or set in your host's dashboard. Never commit real values.
ANTHROPIC_API_KEY=sk-ant-...
# GitHub token with "repo" scope (classic) or Contents read/write (fine-grained). Used to clone and push.
GITHUB_TOKEN=ghp_...
# Required if the URL is public. The UI asks for it once.
APP_PASSWORD=
# Name/email on commits the agent makes.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# Where repos get cloned. Defaults to ./workspaces
WORKSPACE_DIR=
PORT=3000
