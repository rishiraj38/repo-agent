# Copy to .env (or set in your host's dashboard). Never commit real values.

# GitHub OAuth app (https://github.com/settings/developers → New OAuth App).
# Homepage URL = your site URL, Authorization callback URL = <your site URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string used to encrypt login cookies. Any long random value. Generated and saved to disk if empty.
SESSION_SECRET=

# Optional: comma-separated GitHub logins allowed to sign in. Empty = anyone with a GitHub account.
ALLOWED_USERS=

# Optional limits per user
MAX_RUNS_PER_USER=2
MAX_REPOS_PER_USER=10

# Optional. Default model for runs.
AGENT_MODEL=claude-opus-5-5
# Where repos are cloned. ./workspaces locally, /data/workspaces in the Dockerfile.
WORKSPACE_DIR=
PORT=3000
